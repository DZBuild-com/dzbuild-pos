  "fiscalArchive": {
    "readme": {
      "title": "FISCAL ARCHIVE — DZBuild POS",
      "content": "For the period given in manifest.json, this archive holds every validated document (receipts, invoices, credit notes, notes…) with its lines, taxes, payments, parties and links, the audit journal of the period, the Z closures, the versement receipts, the numbering counters with their journaled skips and the company's identity. Nothing is deleted from the database: this archive is a copy of it.",
      "files": "Files: company.csv, documents.csv, document_lines.csv, document_taxes.csv, payments.csv, document_parties.csv, document_links.csv, audit_log.csv, cash_closures.csv, counters.csv, receipts.csv (versement receipts), counter_skips.csv (numbers a restore skipped, journaled), lan_journal.csv (the tills' journals kept by the main PC) (UTF-8 CSV, comma separated, one header row), schema.sql (database structure), chains.json (chain checks), summary.pdf (summary), manifest.json (fingerprints).",
      "hashes": "Every audit journal row and every validated document carries a SHA-256 hash chained to the previous one; the formulas are in manifest.json (algorithms). The SHA-256 of manifest.json is written in the application's audit journal on the day of the export.",
      "verify": "To check: recompute the SHA-256 of every file and compare it with manifest.json; any difference reveals a change."
    },
    "summary": {
      "title": "Fiscal archive — summary",
      "period": "Period",
      "createdAt": "Created on",
      "parts": "Files",
      "rows": "Rows",
      "chains": "Document chains",
      "series": "Series",
      "intact": "Intact",
      "broken": "Altered",
      "audit": "Audit journal",
      "lastHash": "Last hash",
      "tillJournal": "Till journal",
      "tillMerge": "Chain of the tills' journals"
    }
  },
  "diagnostics": {
    "readme": {
      "title": "DZBuild POS diagnostic",
      "contains": "This file holds: the versions of the software, Windows and WebView2, memory and disk, the settings, the printer list, the technical logs of the last 7 days and the crashes.",
      "excludes": "It does not hold: your sales, your customers and their phone numbers, PIN codes, passwords or the database.",
      "send": "Send it to your support by WhatsApp or e-mail only when they ask for it."
    }
  },
