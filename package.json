{
  "name": "dzbuild-pos",
  "version": "1.2.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://dzbuild.com/pos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DZBuild-com/dzbuild-pos.git"
  },
  "bugs": {
    "url": "https://github.com/DZBuild-com/dzbuild-pos/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "perf:bundle": "node scripts/perf/bundle-size.mjs",
    "release:version": "node scripts/release/version.mjs",
    "release:changelog": "node scripts/release/changelog.mjs",
    "release:build": "node scripts/release/build.mjs",
    "release:manifest": "node scripts/release/manifest.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "test:tooling": "node --test \"scripts/**/*.test.mjs\"",
    "test:rust": "cargo test --workspace",
    "e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "i18n": "node scripts/i18n/check-i18n.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:tooling && pnpm i18n && pnpm format:check && pnpm lint:rust && pnpm test:rust"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": ">=1.2.2"
    }
  }
}
